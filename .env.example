# ==============================================================================
# MEX Automation (mexautomation.in) - Environment Variables
# All secrets MUST remain server-side only. Never expose without NEXT_PUBLIC_ prefix.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application URL & General
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://mexautomation.in

# ------------------------------------------------------------------------------
# 2. Database - Neon Serverless Postgres (Free Tier)
# Least-privilege role recommended (INSERT permissions on `leads` table).
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://mex_user:mex_password@ep-sample-123456.ap-southeast-1.aws.neon.tech/mex_db?sslmode=require

# ------------------------------------------------------------------------------
# 3. Email Delivery - Resend (Free Tier: 3,000 emails/month, 100/day)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_1234567890abcdef
# Sales team notification recipient
SALES_EMAIL=sales@mexautomation.in
# From sender address (must be a verified domain on Resend)
EMAIL_FROM=MEX Automation <contact@mexautomation.in>

# ------------------------------------------------------------------------------
# 4. Spam Protection - Cloudflare Turnstile (Free Tier)
# Public site key is safe in browser; secret key stays server-only.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=0x4AAAAAAABBBBBBBB
CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4AAAAAAACCCCCCCC

# ------------------------------------------------------------------------------
# 5. Rate Limiting - Upstash Redis (Free Tier: 10,000 requests/day)
# Enforces limit of 5 form submissions per IP per 10 minutes.
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://sample-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxSampleTokenxxxxxxx=

# ------------------------------------------------------------------------------
# 6. Analytics - Google Analytics 4 (Loaded strictly after cookie consent)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ------------------------------------------------------------------------------
# 7. Error Monitoring - Sentry Developer Plan (Free Tier: 5,000 errors/month)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=https://samplekey@o123456.ingest.sentry.io/7890123
SENTRY_AUTH_TOKEN=sntrys_sampleauthtoken123

